{
  "name": "@edgesweden/consent",
  "version": "0.2.0",
  "description": "Config-driven cookie-consent banner for static and server-rendered sites",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "cookie-banner",
    "astro",
    "astro-integration",
    "csp"
  ],
  "license": "MIT",
  "author": "Harvedge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgeSweden/consent.git"
  },
  "homepage": "https://github.com/EdgeSweden/consent#readme",
  "bugs": "https://github.com/EdgeSweden/consent/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./gtag": {
      "types": "./dist/gtag.d.ts",
      "import": "./dist/gtag.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "size": "node scripts/size-closure.js && size-limit",
    "demo:build": "astro build --root examples/astro && DEMO_VARIANT=non-blocking astro build --root examples/astro",
    "test:e2e": "playwright test",
    "demo:preview": "astro preview --root examples/astro"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^22.20.5",
    "astro": "^5.18.2",
    "astro-min": "npm:astro@5.4.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "astro@5.4.0>vite": "6.2.0"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "astro": ">=5.4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
