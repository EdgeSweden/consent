{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The demo imports the package by name; type-check it against the source, so `check:types`
    // does not depend on a prior `check:build`.
    "paths": {
      "@edgesweden/consent": ["./src/index.ts"],
      "@edgesweden/consent/astro": ["./src/astro/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "*.config.ts"]
}
